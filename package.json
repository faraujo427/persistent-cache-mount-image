    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
